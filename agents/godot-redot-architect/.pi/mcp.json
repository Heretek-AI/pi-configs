{
  "mcpServers": {
    "godot-ai": {
      "command": "uvx",
      "args": [
        "godot-ai",
        "attach"
      ],
      "env": {
        "GODOT_AI_PORT": "9500"
      },
      "lazy": false
    },
    "godot-mcp-headless": {
      "command": "npx",
      "args": [
        "-y",
        "godot-mcp"
      ],
      "lazy": true
    },
    "codebase-memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "lazy": true
    },
    "cyanheads_git-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/git-mcp-server"
      ],
      "lazy": true
    }
  }
}
