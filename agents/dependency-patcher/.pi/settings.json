{
  "name": "dependency-patcher",
  "displayName": "Automated SemVer Lockfile Patcher & Vulnerability Remediation",
  "guild": "Data, Machine Learning & Code Hygiene Guild",
  "model": "claude-3.5-sonnet",
  "thinking": {
    "level": "medium",
    "budgetTokens": "8000"
  },
  "allowedTools": [
    "read",
    "write",
    "edit",
    "bash"
  ],
  "compaction": {
    "strategy": "eesv-verified",
    "threshold": 0.85,
    "preservePromptCache": true
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-yaml-hooks",
    "npm:@juvio15/pi-ast-grep"
  ]
}