{
  "proxyMode": true,
  "lazySpawn": true,
  "maxTokenCap": 3000,
  "servers": {
    "rea-agents": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents"
      ],
      "lazy": true,
      "toolWhitelist": [
        "binary_read_headers",
        "disasm_function",
        "symbol_resolve",
        "decompile_function",
        "xref_trace",
        "process_attach",
        "memory_read_range"
      ]
    },
    "radare2-mcp": {
      "command": "r2mcp",
      "args": [
        "-s"
      ],
      "lazy": true
    },
    "LaurieWired_GhidraMCP": {
      "command": "npx",
      "args": [
        "-y",
        "ghidra-mcp"
      ],
      "lazy": true
    },
    "codebase-memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "lazy": true
    }
  }
}
