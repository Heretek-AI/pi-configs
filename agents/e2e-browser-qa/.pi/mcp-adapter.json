{
  "proxyMode": true,
  "lazySpawn": true,
  "maxTokenCap": 250,
  "servers": {
    "executeautomation_playwright-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ],
      "lazy": true
    },
    "chrome-devtools-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-chrome-devtools-mcp"
      ],
      "lazy": true
    }
  }
}